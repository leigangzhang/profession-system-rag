# ============================================================
# RAG Notion KB — .env 配置模板
# 复制此文件为 .env 并填入真实值
# ============================================================

# --- Notion ---
RAG_KB_NOTION__TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RAG_KB_NOTION__ROOT_PAGE_IDS='["your-32-char-page-id-here"]'

# --- Embedding (DashScope qwen3-vl-embedding) ---
RAG_KB_EMBEDDING__API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Reranker (DashScope qwen3-vl-rerank) ---
RAG_KB_RERANKER__API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 可选覆盖 ---
# RAG_KB_EMBEDDING__MODEL=qwen3-vl-embedding
# RAG_KB_EMBEDDING__DIMENSIONS=2048
# RAG_KB_EMBEDDING__BATCH_SIZE=8
# RAG_KB_RETRIEVAL__DEFAULT_TOP_K=10
# RAG_KB_RETRIEVAL__DEFAULT_MAX_TOKENS=4000
# RAG_KB_STORAGE__DATA_DIR=~/.rag_kb
# RAG_KB_LOGGING__LEVEL=INFO
# RAG_KB_LOGGING__FORMAT=json
